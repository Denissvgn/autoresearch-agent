# Autoresearch Agent local environment template.
# Copy this file to `.env` and fill in deployment-specific values.
# Keep `.env` untracked; this template must not contain real credentials.

# Required LLM backend settings
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# Required when API authentication is enabled for operators/UI clients.
# Use a locally generated random value; do not reuse an LLM provider token.
AUTORESEARCH_API_TOKEN=

# Optional local bind and CORS settings
AUTORESEARCH_BIND_HOST=127.0.0.1
AUTORESEARCH_PORT=8030
AUTORESEARCH_CORS_ORIGINS=http://localhost:8030,http://127.0.0.1:8030,http://localhost:5173,http://127.0.0.1:5173

# Optional runtime and budget controls
AUTORESEARCH_MAX_ITERATIONS=30
AUTORESEARCH_MAX_BUDGET_USD=10.00
AUTORESEARCH_TIMEOUT_S=7200
AUTORESEARCH_MAX_CONCURRENT=2
AUTORESEARCH_LOG_LEVEL=INFO

# Optional preflight controls
AUTORESEARCH_PREFLIGHT_ENABLED=true
AUTORESEARCH_ALLOW_UNREADY_SERVICES=false
AUTORESEARCH_PREFLIGHT_TIMEOUT_S=3
AUTORESEARCH_ARTIFACT_LOGGING_REQUIRED=true
