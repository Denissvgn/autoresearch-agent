# Autoresearch Agent local environment template.
# Copy this file to `.env` and fill in deployment-specific values.
# Keep `.env` untracked; this template must not contain real credentials.

# Required LLM backend settings
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=

# OpenAI backend (required when a skill declares llm.provider: openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Required when API authentication is enabled for operators/UI clients.
# Use a locally generated random value; do not reuse an LLM provider token.
AUTORESEARCH_API_TOKEN=

# Preferred API prefix. Legacy /api remains available for compatibility.
AUTORESEARCH_API_V1_PREFIX=/api/v1

# Optional OAuth2 token introspection endpoint (RFC 7666) for admin JWT
# bearers. Empty (default) disables introspection; only the static API
# token is accepted then.
AUTORESEARCH_IDENTITY_INTROSPECTION_URL=
AUTORESEARCH_IDENTITY_INTROSPECTION_TIMEOUT_S=5

# Optional dedicated bearer token for Prometheus scrapers.
AUTORESEARCH_PROMETHEUS_TOKEN=

# Required for production-scope promotion approval (scheme v2). HMAC-SHA256 secret
# used to verify the approval signature on POST /research/{id}/promote/confirm
# with scope=production. When unset, all production promotions are rejected
# (fail-closed). Set approval.method="hmac-sha256-v2" and sign the canonical
# JSON message produced by src/core/promotion_approval.canonical_approval_message
# (version=production-approval.v2) — it binds the approved candidate
# (iteration + config_snapshot_sha256 + target_identity from promote/preview)
# together with research_id/scope/approver/reason/approved. The legacy
# "{research_id}:{scope}:{approver}" scheme is rejected.
AUTORESEARCH_PRODUCTION_APPROVAL_VERIFIER=

# Optional MLflow tracking (generic; empty disables the integration).
AUTORESEARCH_MLFLOW_TRACKING_URI=
AUTORESEARCH_MLFLOW_EXTERNAL_URL=

# Optional local bind and CORS settings
AUTORESEARCH_BIND_HOST=127.0.0.1
AUTORESEARCH_HOST=0.0.0.0
AUTORESEARCH_PORT=8030
AUTORESEARCH_CORS_ORIGINS=http://localhost:8030,http://127.0.0.1:8030,http://localhost:5173,http://127.0.0.1:5173

# Optional runtime and budget controls
AUTORESEARCH_MAX_ITERATIONS=30
AUTORESEARCH_MAX_BUDGET_USD=10.00
AUTORESEARCH_TIMEOUT_S=7200
AUTORESEARCH_MAX_CONCURRENT=2
AUTORESEARCH_WS_MAX_CLIENTS=100
AUTORESEARCH_LOG_LEVEL=INFO
AUTORESEARCH_ITERATION_CONTEXT_ENABLED=true
AUTORESEARCH_ITERATION_CONTEXT_MAX_CHARS=6000
AUTORESEARCH_ITERATION_CONTEXT_RECENT_ATTEMPTS=5

# Optional preflight controls (checks are declared by each skill's manifest)
AUTORESEARCH_PREFLIGHT_ENABLED=true
AUTORESEARCH_ALLOW_UNREADY_SERVICES=false
AUTORESEARCH_PREFLIGHT_TIMEOUT_S=3

# Demo mode: route all LLM calls to the zero-credential MockProvider
# (scripted edit-run-keep loop, $0 cost). For local demos and CI only —
# the provider router refuses it when ENVIRONMENT=production.
AUTORESEARCH_DEMO=false

# Skill SDK: expose POST /skills/generate (LLM-drafted skill packages —
# the UI wizard / `autoresearch new-skill` parity endpoint). Off by default:
# generation spends real tokens and writes drafts into skills/_drafts/.
AUTORESEARCH_SKILL_GENERATOR_ENABLED=false

# Per-call token budgets (cost control at the provider boundary).
# Output cap is clamped at the historical 8192 ceiling; input cap 0=uncapped
# (>0 forces hardest context compaction once the last call exceeded it).
AUTORESEARCH_MAX_OUTPUT_TOKENS_PER_CALL=8192
AUTORESEARCH_MAX_INPUT_TOKENS_PER_CALL=0
